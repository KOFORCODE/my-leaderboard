{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "(?<p>\\d{1,20})"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(discordbot|facebookexternalhit|twitterbot|telegrambot|slackbot|linkedinbot|whatsapp|instagram|line-|skypeuripreview|embedly|pinterest).*"
        }
      ],
      "destination": "/api/share?p=:p"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ]
}
